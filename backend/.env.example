# Copy this file to .env and fill in real values. Never commit .env.

MONGO_URI=mongodb://127.0.0.1:27017/skillswap
PORT=5000
# Where the React app runs (used for CORS and OAuth redirects back to the app)
FRONTEND_URL=http://localhost:5173
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Zoom Server-to-Server OAuth app
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Google Calendar OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/google/callback

# Microsoft (Outlook) Calendar app registration
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# OUTLOOK_REDIRECT_URI=http://localhost:5000/api/calendar/outlook/callback

# Email (password reset, email verification, session reminders).
# Leave SMTP_HOST empty in development: emails are then printed to the server console.
# Works with any SMTP provider, e.g. Gmail (smtp.gmail.com, port 465, an App Password),
# Brevo, Mailgun, SendGrid or Mailtrap.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SkillSwap <no-reply@example.com>
